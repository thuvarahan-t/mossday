{
  "expo": {
    "name": "Mossday",
    "slug": "mossday",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mossday",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.thuvarahan.mossday"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-audio",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
