{
  "expo": {
    "name": "Mossday",
    "slug": "mossday",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mossday",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.thuvarahan.mossday"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8FA",
          "dark": {
            "backgroundColor": "#0F1115"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
